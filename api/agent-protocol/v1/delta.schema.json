{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbekci.org/agent-protocol/v1/delta.schema.json",
  "title": "delta payload: ordered changes taking the agent from from_version to to_version without gaps",
  "type": "object",
  "required": [
    "from_version",
    "to_version",
    "changes"
  ],
  "additionalProperties": true,
  "properties": {
    "from_version": {
      "type": "integer",
      "minimum": 0
    },
    "to_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Greater than from_version."
    },
    "changes": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "op",
              "entry"
            ],
            "properties": {
              "op": {
                "const": "upsert"
              },
              "entry": {
                "$ref": "defs.schema.json#/$defs/entry"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "op",
              "credential_id"
            ],
            "properties": {
              "op": {
                "const": "remove"
              },
              "credential_id": {
                "$ref": "defs.schema.json#/$defs/uuid"
              }
            }
          }
        ]
      }
    }
  }
}
