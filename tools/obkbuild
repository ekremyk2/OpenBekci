#!/bin/sh
# Build an OpenBekci server binary with extra packs compiled in (xcaddy style).
#
#   tools/obkbuild --with MODULE[@VERSION][=LOCALPATH] [--with ...] [-o OUT] [--tags TAGS] [--keep]
#
#   --with github.com/acme/openbekci-pack-de@v0.3.0   a published module
#   --with github.com/acme/openbekci-pack-de=../de     a local checkout (development)
#
# The pack's root package must export New() returning an sdk.Pack, as
# packs/example does. The script never touches your working tree: it copies
# server/, sdk/ and packs/ into a scratch directory, adds the module to the
# scratch server/go.mod, writes a generated file that appends the pack to
# Official, runs go mod tidy and go build, then checks that the binary boots
# (`version`) and lists the packs (`admin packs list`): the default build's
# packs plus yours.
#
# Needs Go (the version in go.work), a POSIX shell (Bash on Windows) and, for
# published modules, network access. The binary is written to ./openbekci
# (openbekci.exe on Windows) unless -o is given.
set -eu

usage() {
	echo "usage: tools/obkbuild --with MODULE[@VERSION][=LOCALPATH] [--with ...] [-o OUT] [--tags TAGS] [--keep]" >&2
	exit 2
}

root=$(cd "$(dirname "$0")/.." && pwd)
out=
tags=
keep=
specs=
while [ $# -gt 0 ]; do
	case $1 in
	--with)
		[ $# -ge 2 ] || usage
		specs="$specs$2
"
		shift 2
		;;
	-o)
		[ $# -ge 2 ] || usage
		out=$2
		shift 2
		;;
	--tags)
		[ $# -ge 2 ] || usage
		tags=$2
		shift 2
		;;
	--keep)
		keep=1
		shift
		;;
	*) usage ;;
	esac
done
[ -n "$specs" ] || usage

case $(uname -s) in MINGW* | MSYS* | CYGWIN*) exe=.exe ;; *) exe= ;; esac
[ -n "$out" ] || out=$PWD/openbekci$exe
case $out in /* | [A-Za-z]:*) ;; *) out=$PWD/$out ;; esac

# Local paths are relative to where the command is run: make them absolute first.
resolved=
IFS='
'
for spec in $specs; do
	case $spec in
	*=*)
		p=${spec#*=}
		abs=$(cd "$p" 2>/dev/null && pwd) || {
			echo "obkbuild: $p not found" >&2
			exit 1
		}
		spec=${spec%%=*}=$abs
		;;
	esac
	resolved="$resolved$spec
"
done

work=$(mktemp -d)
[ -n "$keep" ] || trap 'rm -rf "$work"' EXIT
echo "obkbuild: scratch copy in $work"
cp -R "$root/server" "$root/sdk" "$root/packs" "$work/"
cd "$work/server"
export GOWORK=off # the scratch copy resolves everything through server/go.mod

gen=cmd/openbekci/packs_obkbuild.go
imports=
appends=
n=0
for spec in $resolved; do
	mod=${spec%%=*}
	local=
	[ "$mod" = "$spec" ] || local=${spec#*=}
	ver=latest
	case $mod in *@*) ver=${mod#*@} mod=${mod%@*} ;; esac
	n=$((n + 1))
	if [ -n "$local" ]; then
		go mod edit -require="$mod@v0.0.0" -replace="$mod=$local"
	else
		go get "$mod@$ver"
	fi
	imports="$imports	pack$n \"$mod\"
"
	appends="$appends	Official = append(Official, pack$n.New())
"
done
unset IFS
# init runs after the package-level Official is initialised, in any build.
printf '// Code generated by tools/obkbuild; DO NOT EDIT.\n\npackage main\n\nimport (\n%s)\n\nfunc init() {\n%s}\n' \
	"$imports" "$appends" >"$gen"

go mod tidy
CGO_ENABLED=0 go build -trimpath -buildvcs=false ${tags:+-tags "$tags"} -o "$out" ./cmd/openbekci

"$out" version
list=$("$out" admin packs list)
printf '%s\n' "$list"
got=$(printf '%s\n' "$list" | grep -c ' (sdk >= ' || true)
base=$(grep -c '\.New()' cmd/openbekci/packs_default.go || true)
if [ "$got" -lt $((base + n)) ]; then
	echo "obkbuild: expected at least $((base + n)) packs in the binary, found $got" >&2
	exit 1
fi
echo "obkbuild: built $out with $n extra pack(s)"
