# Local development settings. Copy to .env (git-ignored); `tools/task.ps1 run`
# and `tools/task.ps1 migrate` read it. Not for deployment: see
# deploy/compose/.env.example for that.

OPENBEKCI_LISTEN_ADDR=:8484
OPENBEKCI_BASE_URL=http://localhost:8484

# Roles created by tools/dev-db.ps1 roles (dev passwords, local only).
OPENBEKCI_DATABASE_URL=postgres://openbekci_app:openbekci@localhost:5432/openbekci
OPENBEKCI_PLATFORM_DATABASE_URL=postgres://openbekci_platform:openbekci@localhost:5432/openbekci
OPENBEKCI_MIGRATOR_DATABASE_URL=postgres://openbekci_migrator:openbekci@localhost:5432/openbekci

# DEV-ONLY KEYS. Public in this repository; the server accepts them only while
# INSECURE_DEV=true. Generate real ones with: openssl rand -base64 48
OPENBEKCI_SECRET_KEY=O5UXjIbaHRkxmT+4T/2TwQBBJYnTTVA7+x3jgVKFi9A3P/dRrnmw6gmCVcs5LkA/
OPENBEKCI_ENCRYPTION_KEY=FRc8OaqwKVXLgzx/hDqj4CueiU8gG+sZE69/DZjU4+ilciEEcoihYrJhYpcl/Jqg

OPENBEKCI_DATA_DIR=./data
OPENBEKCI_INSECURE_DEV=true
OPENBEKCI_DEBUG=true
# Check every API response against the OpenAPI spec (dev aid).
OPENBEKCI_API_VALIDATE_RESPONSES=true
OPENBEKCI_INSTANCE_NAME=OpenBekci (dev)

# Used only by `go test` integration tests.
# OPENBEKCI_TEST_SUPERUSER_URL=postgres://postgres:postgres@localhost:5432/postgres
