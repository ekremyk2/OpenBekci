# Local development settings. Copy to .env (git-ignored); `tools/task.ps1 run`
# and `tools/task.ps1 migrate` read it. Not for deployment: see
# deploy/compose/.env.example for that.

OPENBEKCI_LISTEN_ADDR=:8484
OPENBEKCI_BASE_URL=http://localhost:8484

# Roles created by tools/dev-db.ps1 roles (dev passwords, local only).
OPENBEKCI_DATABASE_URL=postgres://openbekci_app:openbekci@localhost:5432/openbekci
OPENBEKCI_PLATFORM_DATABASE_URL=postgres://openbekci_platform:openbekci@localhost:5432/openbekci
OPENBEKCI_MIGRATOR_DATABASE_URL=postgres://openbekci_migrator:openbekci@localhost:5432/openbekci

# DEV-ONLY KEYS. Public in this repository; the server accepts them only while
# INSECURE_DEV=true (itself accepted only when BASE_URL is localhost, 127.0.0.1 or [::1]).
# Generate real ones with: openssl rand -base64 48
OPENBEKCI_SECRET_KEY=O5UXjIbaHRkxmT+4T/2TwQBBJYnTTVA7+x3jgVKFi9A3P/dRrnmw6gmCVcs5LkA/
OPENBEKCI_ENCRYPTION_KEY=FRc8OaqwKVXLgzx/hDqj4CueiU8gG+sZE69/DZjU4+ilciEEcoihYrJhYpcl/Jqg

OPENBEKCI_DATA_DIR=./data
OPENBEKCI_INSECURE_DEV=true
OPENBEKCI_DEBUG=true
# Check every API response against the OpenAPI spec (dev aid).
OPENBEKCI_API_VALIDATE_RESPONSES=true
# Cap on JSON request bodies in bytes (default 1048576); larger bodies get a 413 problem.
# OPENBEKCI_MAX_BODY_BYTES=1048576

# Files (uploads stream through the server; see server/README.md "Files and storage").
# Largest single file in bytes (default 26214400 = 25 MiB). Only the multipart
# upload route is held to this, not the JSON cap above.
# OPENBEKCI_MAX_UPLOAD_BYTES=26214400
# Narrow the allowed file types (default: jpg jpeg png webp pdf txt csv docx xlsx pptx odt ods doc xls).
# OPENBEKCI_FILES_ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf
# Storage driver: local (default, files under DATA_DIR/files) or s3.
# OPENBEKCI_STORAGE_DRIVER=local
# OPENBEKCI_STORAGE_S3_BUCKET=openbekci
# OPENBEKCI_STORAGE_S3_REGION=us-east-1
# OPENBEKCI_STORAGE_S3_ENDPOINT=http://localhost:9000   # S3-compatible stores (MinIO, R2, ...); empty for AWS
# OPENBEKCI_STORAGE_S3_ACCESS_KEY=
# OPENBEKCI_STORAGE_S3_SECRET_KEY=                      # also OPENBEKCI_STORAGE_S3_SECRET_KEY_FILE
# OPENBEKCI_STORAGE_S3_PATH_STYLE=true
# OPENBEKCI_STORAGE_S3_PREFIX=
# Scan uploads with ClamAV (clamd address, host:port or unix:/path); unset skips scanning.
# OPENBEKCI_CLAMAV_ADDR=localhost:3310
# Longest one virus scan may take (default 60s); a scanner that is slower fails the upload with 503.
# OPENBEKCI_CLAMAV_TIMEOUT=60s
# Images with more pixels than this are refused with 422 (default 25000000 = 25 megapixels);
# a decoded image costs 4 bytes per pixel.
# OPENBEKCI_MAX_IMAGE_PIXELS=25000000
# How many images the server decodes at once (default: half the CPUs, at least 1).
# OPENBEKCI_IMAGE_WORKERS=2
OPENBEKCI_INSTANCE_NAME=OpenBekci (dev)

# Sign-in codes and magic links are written to the server log instead of being
# sent. Dev only (refused without INSECURE_DEV). Real settings: SMS_PROVIDER=netgsm
# with SMS_NETGSM_*, MAIL_PROVIDER=smtp with SMTP_*.
OPENBEKCI_SMS_PROVIDER=log
OPENBEKCI_MAIL_PROVIDER=log

# Send budgets of sign-in codes and links, on top of the per-address limits:
# messages per phone number or address per day (default 10), and per instance
# per hour for SMS (default 120) and for mail (default 300). A negative value
# removes the limit. A message over budget is dropped, logged at WARN
# ("delivery dropped") and recorded in the delivery log (`admin delivery-log --failed`).
# OPENBEKCI_SEND_DAILY_BUDGET=10
# OPENBEKCI_SMS_HOURLY_BUDGET=120
# OPENBEKCI_MAIL_HOURLY_BUDGET=300

# Used only by `go test` integration tests.
# OPENBEKCI_TEST_SUPERUSER_URL=postgres://postgres:postgres@localhost:5432/postgres
