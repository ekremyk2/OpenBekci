# OpenBekci compose settings. Copy to .env and fill in EVERY value marked
# REQUIRED. The server refuses to start with placeholder or weak keys.
#
# Generate each secret with:   openssl rand -base64 48

# REQUIRED: public hostname Caddy serves (it obtains the HTTPS certificate).
OPENBEKCI_DOMAIN=bekci.example.org

# REQUIRED: public URL; used for cookies, links and Origin checks. Must be https.
OPENBEKCI_BASE_URL=https://bekci.example.org

# Optional: additional accepted origins, comma separated (for example a LAN name).
# OPENBEKCI_EXTRA_ORIGINS=

# REQUIRED: signing/session key, at least 32 random bytes.
OPENBEKCI_SECRET_KEY=changeme-generate-with-openssl-rand-base64-48

# REQUIRED: key that encrypts sensitive columns, at least 32 random bytes.
# Losing it makes the encrypted data unrecoverable: back it up with the database.
OPENBEKCI_ENCRYPTION_KEY=changeme-generate-with-openssl-rand-base64-48

# REQUIRED: password of the three application database roles
# (openbekci_migrator, openbekci_app, openbekci_platform).
OPENBEKCI_DB_PASSWORD=changeme

# REQUIRED: password of the PostgreSQL superuser (used only to bootstrap).
OPENBEKCI_DB_SUPERUSER_PASSWORD=changeme

# Optional: run the job worker inside the server (embedded, default) or not (off).
# OPENBEKCI_WORKER=embedded

# Optional: log at debug level.
# OPENBEKCI_DEBUG=false

# Optional: shown to apps in the discovery document.
# OPENBEKCI_INSTANCE_NAME=OpenBekci
# OPENBEKCI_BRANDING_LOGO_URL=
# OPENBEKCI_BRANDING_PRIMARY_COLOR=
# OPENBEKCI_MIN_APP_VERSION_ANDROID=1.0.0
# OPENBEKCI_MIN_APP_VERSION_IOS=1.0.0
